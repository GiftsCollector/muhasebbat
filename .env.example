# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# Leave empty to use local SQLite
# For production, set DATABASE_URL to your PostgreSQL URL
DATABASE_URL=

# Server Configuration
PORT=5000

# SMS password recovery
# SMS_PROVIDER=log          # for local testing, does not send
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_PROVIDER=smsmisr
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_SENDER=
# SMS_PROVIDER=http
# SMS_API_URL=
# SMS_API_TOKEN=

# Email password recovery (Gmail SMTP + App Password)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_DEFAULT_SENDER=your-gmail@gmail.com
