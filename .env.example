# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# Leave empty to use local SQLite
# For production, set DATABASE_URL to your PostgreSQL URL
DATABASE_URL=

# Server Configuration
PORT=5000

